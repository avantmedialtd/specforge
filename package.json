{
    "name": "specforge",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc --noEmit && vite build",
        "test": "bun test",
        "preview": "vite preview",
        "tauri": "tauri",
        "tauri:devtools": "SPECFORGE_OPEN_DEVTOOLS=1 tauri dev",
        "wt:dev": "bun scripts/worktree-slot.ts",
        "version": "bun run scripts/bump-version.ts",
        "icons:web": "bun scripts/gen-web-icons.ts",
        "site:dev": "bun run --cwd site dev",
        "site:build": "bun run --cwd site build",
        "site:preview": "bun run --cwd site preview",
        "site:test": "bun run --cwd site test:e2e",
        "site:test:unit": "bun run --cwd site test:unit"
    },
    "dependencies": {
        "@tauri-apps/api": "^2.11.1",
        "@tauri-apps/plugin-autostart": "^2.5.1",
        "@tauri-apps/plugin-dialog": "^2.7.2",
        "@tauri-apps/plugin-notification": "^2.3.3",
        "@tauri-apps/plugin-window-state": "^2.4.1",
        "katex": "^0.16.47",
        "mermaid": "^11.17.2",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "react-markdown": "^10.1.0",
        "rehype-highlight": "^7.0.2",
        "rehype-katex": "^7.0.1",
        "remark-gfm": "^4.0.1",
        "remark-math": "^6.0.0"
    },
    "devDependencies": {
        "@tauri-apps/cli": "^2.11.4",
        "@types/bun": "^1.4.0",
        "@types/node": "^26.4.0",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.5",
        "@vitejs/plugin-react": "^6.1.0",
        "typescript": "^7.0.2",
        "vite": "^8.2.2"
    }
}
