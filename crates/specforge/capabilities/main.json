        "allow-get-claude-quota",
        "allow-get-claude-quota-enabled",
        "allow-get-collapsed-tree-node-ids",
        "allow-get-commit-detail",
        "allow-get-commit-diff",
        "allow-get-commit-file-image",
        "allow-get-commit-garden",
        "allow-get-commit-graph",
        "allow-get-commit-history-enabled",
        "allow-get-dashboard",
        "allow-get-document-width",
