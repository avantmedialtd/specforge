{
    "$schema": "../../../node_modules/@tauri-apps/cli/schema.json",
    "identifier": "main",
    "description": "The main window's capability: the complete application surface, and nothing beyond it. It grants the core baseline, the two window operations its hidden-inset titlebar uses (dragging and double-click maximise), the folder picker's dialog plugin, and exactly the application commands that surface calls — every handler except the two detached-window size setters, which only a reader or pull-request window invokes. Application-command permissions come from build.rs's AppManifest::commands (pull-request-actions: Application Commands Are Granted Per Window Kind).",
    "windows": [
        "main"
    ],
    "permissions": [
        "core:default",
        "core:window:allow-start-dragging",
        "core:window:allow-toggle-maximize",
        "dialog:default",
        "allow-abandon-review-operation",
